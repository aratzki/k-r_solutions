#include <stdio.h>

int main()
{
    // celcius to fahrenheit conversion table
    // modify the temp conversion program to print a  heading above the table
    // write a program to print corresponding celcius to farenheit table
    // exercise 5: modift the temperature conversion program to print the table in the reverse order, that is, from 300 degrees celcius down to 0

    float celcius, fahr;
    int lower, upper, step;
    lower = 300;
    upper = 0;
    step = -20;

    printf("Celcius to fahrenheit conversion table\n");
    printf("celcius fahr\n");
    celcius = lower;
    while (celcius >= upper)
    {
        fahr = (9.0 / 5.0) * celcius + 32.0;
        printf("%6.1f %3.0f\n", celcius, fahr);
        celcius = celcius + step;
    }

    return 0;
}
