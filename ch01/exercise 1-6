// chapter 1: a tutorial introduction
#include <stdio.h>

int main()
{
    // exercise 1-6: verify that the expression getchar() != EOF is 0 or 1

    int c;
    while ((c = getchar()) != EOF)
    {
        printf("getchar() != EOF evaluates to: %d\n", c != EOF);
    }

    printf("Reached EOF. getchar() != EOF evaluates to: %d\n", c != EOF);

    return 0;
}
